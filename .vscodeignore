.vscode/**
**/*.map
**/*.ts
# Only the COMPILED output is re-included. vsce does not use gitignore's "last match wins": a
# negated pattern beats every ignore pattern no matter where it sits (collectFiles() in vsce's
# package.js), so negating the whole folder (`!out/**`) drags the source maps straight back in.
!out/**/*.js
host/obj/**
host/bin/**
# ModelHost is a second project UNDER host/ (the local model server, NOTES.md §92). Its bin/ holds
# llama.cpp's native backends for every platform — hundreds of megabytes that NuGet regenerates on the
# user's machine, so a `host/obj|bin/**` pattern that only matches one level deep is not enough.
host/**/obj/**
host/**/bin/**
**/node_modules/.cache/**
.gitignore
# The automated test suite (runner, jsdom, generated test projects) is not part of the runtime extension.
tests/**
TEST_PLAN.md
# Maintainer-only release guide (publisher + PAT setup) — not for extension users.
PUBLISHING.md
# Repo infrastructure: CI workflows and the issue templates are for GitHub, not for users.
# (vsce's own default-ignore list contains a bare `.github`, but default patterns are NOT
# folder-expanded the way `.vscodeignore` entries are, so they never match nested files.)
.github/**
# Dev-only docs (kept out of the package; README/USER_MANUAL/CONTROLS stay in).
NOTES.md
NOTES_ARCHIVE.md
NOTES_2026-09-03.md
NOTES_MEMORY_2026-09-03.md
SESSION.md
# Local tool state (e.g. the .poolside agent settings) is not part of the extension.
.poolside/**
# NOTE: GrumpyWhite.png is the Activity Bar container icon
# (package.json -> contributes.viewsContainers.activitybar[].icon). It MUST ship — excluding it
# makes the Grumpy's WYSIWYG Designer icon vanish from the sidebar with no error anywhere. Guarded by
# tests/t2-logic/packaging.test.js.
# Source artwork for the two icons above: the same badge, kept for future re-exports. Grumpy.png is
# the version with the background outside the ring removed, GrumpyWhite.png the white glyph derived
# from it (see NOTES.md §88) — only the two derived files are referenced by the manifest.
Grumpy_128x128.png
# The README's at-a-glance collage. It is ~900 KB — four times the rest of the package — and vsce
# rewrites relative README image links to the repository, so the Marketplace serves it from GitHub
# either way. Excluded to keep the .vsix at ~1.2 MB; Grumpy.png (27 KB, the logo) still ships.
DesignerDemo.png
# Build metadata: VS Code only needs package.json plus the compiled out/ folder.
tsconfig.json
# The icon generator (tools/make-activitybar-icon.py) is a developer tool, not runtime code: it draws
# GrumpyWhite.png from shapes so the glyph can be regenerated or adjusted (NOTES.md §93).
tools/**
