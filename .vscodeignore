.vscode/**
**/*.map
**/*.ts
# Only the COMPILED output is re-included. vsce does not use gitignore's "last match wins": a
# negated pattern beats every ignore pattern no matter where it sits (collectFiles() in vsce's
# package.js), so negating the whole folder (`!out/**`) drags the source maps straight back in.
!out/**/*.js
host/obj/**
host/bin/**
**/node_modules/.cache/**
.gitignore
# The automated test suite (runner, jsdom, generated test projects) is not part of the runtime extension.
tests/**
TEST_PLAN.md
# Maintainer-only release guide (publisher + PAT setup) — not for extension users.
PUBLISHING.md
# Repo infrastructure: CI workflows and the issue templates are for GitHub, not for users.
# (vsce's own default-ignore list contains a bare `.github`, but default patterns are NOT
# folder-expanded the way `.vscodeignore` entries are, so they never match nested files.)
.github/**
# Dev-only docs (kept out of the package; README/USER_MANUAL/CONTROLS stay in).
NOTES.md
NOTES_ARCHIVE.md
NOTES_2026-09-03.md
NOTES_MEMORY_2026-09-03.md
SESSION.md
# Local tool state (e.g. the .poolside agent settings) is not part of the extension.
.poolside/**
# Repo artwork that no shipped code loads (the Marketplace icon is Grumpy.png).
GrumpyWhite.png
# Build metadata: VS Code only needs package.json plus the compiled out/ folder.
tsconfig.json
