<!-- Do NOT edit this file manually - Use the Designer to make changes -->
<chrome:ChromeWindow xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="494" x:Class="GrumpyDesignerDemo.MainWindow" Title="GrumpyDesignerDemo" Width="800" Height="500" xmlns:chrome="using:AvaloniaChrome" TitleBarTitle="Grumpy's Form Designer Demo" TitleBarIcon="avares://GrumpyDesignerDemo/Assets/Goggles_Logo.png" Icon="avares://GrumpyDesignerDemo/Assets/Grumpy_128x128-1.png" CornerRadius="10" TitleBarHeight="30" BorderBrush="#0A0593" BorderThickness="2,2,2,2" WindowStartupLocation="CenterScreen" TitleBarForeground="Teal" MinHeight="80" xmlns:dg="using:Avalonia.Controls" xmlns:spread="using:AvaloniaSpreadsheet" xmlns:charts="using:AvaloniaCharts" Background="Transparent">
  <DockPanel Name="Root" LastChildFill="True">
    <chrome:GrumpyPanel x:Name="GrumpyStatus1" DockPanel.Dock="Bottom" Height="26" Background="#333333" BorderBrush="#333333" BorderThickness="0" CornerRadius="0">
      <DockPanel x:Name="GrumpyStatus1Dock" LastChildFill="True">
        <TextBlock x:Name="GrumpyStatus1Label" Text="Ready" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#E6E6E6" FontSize="13"/>
        <TextBlock x:Name="GrumpyStatus1Date" Text="2026/09/27 14:42:47" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#E6E6E6" FontSize="13" Loaded="GrumpyStatus1Date_Loaded"/>
        <Canvas x:Name="GrumpyStatus1Body"/>
      </DockPanel>
    </chrome:GrumpyPanel>
    <Menu x:Name="Menu1" DockPanel.Dock="Top" Height="24" SelectionChanged="Menu1_SelectionChanged">
      <Menu.Styles>
        <Style Selector="Separator.MenuBarDivider">
          <Setter Property="Width" Value="1"/>
          <Setter Property="Height" Value="16"/>
          <Setter Property="Margin" Value="6,3"/>
          <Setter Property="HorizontalAlignment" Value="Center"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
          <Setter Property="Template">
            <ControlTemplate TargetType="Separator">
              <Border Width="1" VerticalAlignment="Stretch" HorizontalAlignment="Center" Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"/>
            </ControlTemplate>
          </Setter>
        </Style>
      </Menu.Styles>
      <MenuItem Header="File">
        <MenuItem Header="Open...">
          <chrome:PathPicker Width="160" Height="24" PathType="File" Title="Select File.."/>
        </MenuItem>
      </MenuItem>
      <MenuItem Header="About" Click="About_Click"/>
      <Separator Classes="MenuBarDivider"/>
      <MenuItem Header="Exit" Click="Exit_Click"/>
    </Menu>
    <chrome:GrumpyCommandBar x:Name="GrumpyCommandBar1" DockPanel.Dock="Top" Height="36" Padding="8,0" Background="Transparent" BorderBrush="#909090" BorderThickness="0,0,0,1" CornerRadius="0">
      <StackPanel x:Name="GrumpyCommandBar1Items" Orientation="Horizontal" Spacing="6">
        <Button x:Name="GrumpyCommandBar1Open" VerticalAlignment="Center" Click="GrumpyCommandBar1Open_Click">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="M2,4 L7,4 L9,7 L15,7 L15,13 L2,13 Z" Width="16" Height="16"/>
            <TextBlock Text="Open..." VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="GrumpyCommandBar1Save" VerticalAlignment="Center" Click="GrumpyCommandBar1Save_Click">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="M2,2 L12,2 L14,4 L14,14 L2,14 Z M5,2 L5,7 L11,7 L11,2 Z M5,10 L11,10 L11,14 L5,14 Z" Width="16" Height="16"/>
            <TextBlock Text="Save..." VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border x:Name="btn1" Width="1" Height="18" Background="#FF808080" VerticalAlignment="Center"/>
        <ToggleButton x:Name="GrumpyCommandBar1Path" Content="Lock" VerticalAlignment="Center" Width="50" Height="33"/>
      </StackPanel>
    </chrome:GrumpyCommandBar>
    <Canvas Name="Body"/>
    <TabControl x:Name="TabControl1" SelectionChanged="TabControl1_SelectionChanged" Background="#1D1D1E" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
      <TabItem Header="Buttons etc." Height="48" Width="140" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" FontStyle="Italic" Foreground="White" BorderBrush="#0C027C" BorderThickness="4" CornerRadius="10">
        <DockPanel x:Name="TabControl1Body1">
          <Canvas x:Name="TabControl1Body1Canvas">
            <Button x:Name="Button1" Content="Click me..." Width="120" Height="32" Canvas.Left="8" Canvas.Top="16" Click="Button1_Click" HorizontalContentAlignment="Center"/>
            <CheckBox x:Name="CheckBox1" Content="CheckBox" IsCheckedChanged="CheckBox1_IsCheckedChanged" Canvas.Left="151" Canvas.Top="16" Width="120"/>
            <RadioButton x:Name="RadioButton1" Content="RadioButton" IsCheckedChanged="RadioButton1_IsCheckedChanged" Canvas.Left="293" Canvas.Top="16" Width="120"/>
            <ToggleSwitch x:Name="ToggleSwitch1" Content="Toggle Switch" OnContent="On" OffContent="Off" Canvas.Left="436" Canvas.Top="3" Click="ToggleSwitch1_Click" Width="120"/>
          </Canvas>
        </DockPanel>
      </TabItem>
      <TabItem Header="SplitPanel/Image/DataGrid" FontStyle="Italic" FontSize="20" Foreground="White" BorderBrush="#0C027C" BorderThickness="4" CornerRadius="10" Width="290" Height="48">
        <DockPanel x:Name="TabControl1Body2">
          <Canvas x:Name="TabControl1Body2Canvas"/>
          <Border x:Name="SplitPanel2" BorderBrush="#909090" BorderThickness="2" Padding="1" Background="#E6E6E6">
            <Grid>
              <Border BorderThickness="1" BorderBrush="#808080" Background="Black">
                <DockPanel x:Name="SplitPanel2Pane0" LastChildFill="False">
                  <Image x:Name="Image1" Stretch="Uniform"/>
                  <chrome:Timer x:Name="Timer1" Interval="1000" Enabled="False" Tick="Timer1_Tick"/>
                </DockPanel>
              </Border>
              <GridSplitter ResizeDirection="Columns" Background="#B0B0B0" MinWidth="1" MinHeight="1" Width="5" Grid.Column="1"/>
              <Border BorderThickness="1" BorderBrush="#808080" Background="White" Grid.Column="2">
                <DockPanel x:Name="SplitPanel2Pane1" LastChildFill="True" Background="Black">
                  <dg:DataGrid x:Name="DataGrid1" AutoGenerateColumns="True" SelectionChanged="DataGrid1_SelectionChanged" Background="#18036C" Foreground="#dde2e8" RowHeaderWidth="10" GridLinesVisibility="Horizontal">
                    <dg:DataGrid.Styles>
                      <Style Selector="dg|DataGridColumnHeader">
                        <Setter Property="Foreground" Value="#dbe0e4"/>
                        <Setter Property="FontSize" Value="14"/>
                      </Style>
                    </dg:DataGrid.Styles>
                  </dg:DataGrid>
                </DockPanel>
              </Border>
              <GridSplitter ResizeDirection="Columns" Background="#B0B0B0" MinWidth="1" MinHeight="1" Width="5" Grid.Column="3"/>
              <Border BorderThickness="1" BorderBrush="#808080" Background="White" Grid.Column="4">
                <Canvas x:Name="SplitPanel2Pane2" Background="Black">
                  <ComboBox x:Name="ComboBox1" Width="130" Height="32" Canvas.Left="8" Canvas.Top="6" SelectionChanged="ComboBox1_SelectionChanged" chrome:AnchorHelper.Anchor="Left,Top"/>
                </Canvas>
              </Border>
              <GridSplitter ResizeDirection="Rows" Background="#B0B0B0" MinWidth="1" MinHeight="1" Height="5" Grid.Row="1" Grid.ColumnSpan="5"/>
              <Border BorderThickness="1" BorderBrush="#808080" Background="White" Grid.Row="2" Grid.ColumnSpan="5">
                <DockPanel x:Name="SplitPanel2Pane3" LastChildFill="True">
                  <ProgressBar x:Name="ProgressBar1" Minimum="0" Maximum="100" Value="0.5" ValueChanged="ProgressBar1_ValueChanged" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="#01072A" Foreground="#87438F"/>
                </DockPanel>
              </Border>
              <Grid.RowDefinitions>
                <RowDefinition Height="335*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="254*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="358*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="148*"/>
              </Grid.ColumnDefinitions>
            </Grid>
          </Border>
        </DockPanel>
      </TabItem>
      <TabItem Header="SpreadSheet" FontStyle="Italic" FontSize="20" Foreground="White" BorderBrush="#0C027C" BorderThickness="4" CornerRadius="10" Width="160" Height="48">
        <DockPanel x:Name="TabControl1Body3" LastChildFill="True">
          <spread:GrumpySheet x:Name="GrumpySheet1" Margin="1.6,-0.5,0,0" HeaderBackColor="#2F3031" HeaderTextColor="#A8ADAD" EditTextColor="#CDD0D5" EditBackColor="#282443" GridColor="#4E4F52" CellBackColor="#6A6565" Rows="50" Columns="26">
            <spread:SheetCell Row="1" Column="1" Text=" "/>
            <spread:SheetCell Row="1" Column="2" Text="  "/>
            <spread:SheetCell Row="2" Column="2" Text=" "/>
            <spread:SheetCell Row="3" Column="1" Text=" "/>
            <spread:SheetCell Row="4" Column="1" Text=" "/>
            <spread:SheetCell Row="5" Column="1" Text=" "/>
            <spread:SheetCell Row="6" Column="1" Text=" "/>
            <spread:SheetCell Row="7" Column="1" Text=" "/>
            <spread:SheetCell Row="8" Column="1" Text=" "/>
            <spread:SheetCell Row="9" Column="1" Text=" "/>
            <spread:SheetCell Row="10" Column="1" Text=" "/>
            <spread:SheetCell Row="11" Column="1" Text=" "/>
            <spread:SheetCell Row="3" Column="2" Text=" "/>
            <spread:SheetCell Row="11" Column="2" Text=" "/>
          </spread:GrumpySheet>
        </DockPanel>
      </TabItem>
      <TabItem Header="Charting" FontStyle="Italic" FontSize="20" Foreground="White" BorderBrush="#0C027C" BorderThickness="4" CornerRadius="10">
        <DockPanel x:Name="TabControl1Body4" LastChildFill="True">
          <charts:GrumpySurfacePlot x:Name="GrumpySurfacePlot1" SampleSets="0,20,40,50,40,20,0,20,40,50,40,20,0; 0,18,36,45,36,18,0,18,36,45,36,18,0; 0,16,32,40,32,16,0,16,32,40,32,16,0; 0,14,28,35,28,14,0,14,28,35,28,14,0" Title="Surface Plot - Solid Surface" ShowTitle="True" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" LegendPosition="Left" LegendBackColor="#040541" LegendBorderBrush="#050269" LegendBorderThickness="3" LegendCornerRadius="10" MaxX="35" BorderBrush="#010370" BorderThickness="3" CornerRadius="10" TitleColor="White" ZoomX="50" ZoomY="50" XAxisTitle="mm" YAxisTitle="mm" ZAxisTitle="mm" AxisColor="#767373" GridColor="#807A7A" Style="Solid">
            <charts:GrumpySurfacePlot.PlotBackBrush>
              <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#67A4E1" Offset="0"/>
                <GradientStop Color="#335373" Offset="0.5"/>
                <GradientStop Color="#0B1218" Offset="1"/>
              </LinearGradientBrush>
            </charts:GrumpySurfacePlot.PlotBackBrush>
            <charts:XYSeries/>
