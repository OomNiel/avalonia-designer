<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ModelHost — the bundled local model server for the AI assist (NOTES.md §92).

    It exists so the extension does not have to ship a native runtime: this project is *built on the
    user's machine* next to the designer's PreviewerHost (the extension ships the sources, runs
    `dotnet build`, and runs the result). NuGet then picks the right llama.cpp backend for the current
    RID — one VSIX for every platform and architecture — and the model file itself is downloaded once
    into the extension's storage, because a 2 GB GGUF can never travel inside a VSIX.

    The server speaks just enough of the OpenAI API for `src/assistant.ts` to talk to it unchanged:
    GET /health, GET /v1/models, POST /v1/chat/completions (streaming SSE or one JSON body).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ModelHost</AssemblyName>
    <RootNamespace>ModelHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <!--
    Two native backends, one binary (2026-09-16).

    The CPU package is what runs by default: LLamaSharp is explicitly told `WithVulkan(false)` unless the user
    asks for the GPU build (the `backend` switch in the extension, which arrives here as the `backend` argument),
    so nothing about the default changes because a second package is referenced. It is always referenced
    (rather than added on demand) because that keeps ONE build and ONE binary: the choice is a flag on the
    command line, so it shows up in the extension's log like every other decision, and switching back and
    forth cannot leave a stale build behind that lies about itself.

    The Vulkan natives land in `runtimes/<rid>/native/vulkan/` next to the CPU ones and are chosen by
    LLamaSharp by directory, so the two sets cannot collide. They are ~65 MB per RID and are copied into
    bin/, which is excluded from both the VSIX and git (see .vscodeignore / .gitignore).
  -->
  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Version="0.27.0" />
  </ItemGroup>

</Project>
