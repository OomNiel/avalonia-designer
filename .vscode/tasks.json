{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "dotnet: build host",
            "type": "shell",
            "command": "dotnet build host/PreviewerHost.csproj",
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "npm: compile",
            "type": "npm",
            "script": "compile",
            "group": "build",
            "problemMatcher": "$tsc"
        },
        {
            "label": "build: all",
            "dependsOn": [
                "dotnet: build host",
                "npm: compile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}